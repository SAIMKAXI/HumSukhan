<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the platform splash-screen window. Keep the splash icon
         aligned with the canonical HumSukhan application icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/humsukhan_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
