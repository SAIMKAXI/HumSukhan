<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Wellbeing check-ins stay on this phone only
     (lib/modules/wellbeing/services/mood_store.dart): they are left out of
     cloud backup and of transfer to a new device. Everything else is backed
     up as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="wellbeing/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="wellbeing/" />
    </device-transfer>
</data-extraction-rules>
