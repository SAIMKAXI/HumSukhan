# HumSukhan Environment Configuration
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# The Gemini key is NOT an app setting: it is a Supabase Edge Function secret
# (see SUPABASE_EDGE_SECRETS.md). Anything in this file is compiled into the APK.
