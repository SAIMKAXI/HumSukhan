# HumSukhan Backend Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://humsukhan:humsukhan_secret@localhost:5432/humsukhan

# Security (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this

# AI Services (optional - for AI insights)
OPENAI_API_KEY=sk-your-openai-api-key

# Application
DEBUG=true
LOG_LEVEL=INFO
